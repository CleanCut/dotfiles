[color]
ui = true
[core]
excludesfile = ~/.gitignore-global
pager = delta
[interactive]
diffFilter = delta --color-only
[delta]
navigate = true
line-numbers = true
pager = less -RFXM
[user]
name = Nathan Stocks
email = nathan.s@oxen.ai
[mergetool "Kaleidoscope"]
cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
trustexitcode = true
[difftool]
prompt = false
[mergetool]
prompt = false
[github]
user = CleanCut
[push]
default = simple
autoSetupRemote = true
# [credential]
# helper = osxkeychain
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[protocol]
version = 2
[pull]
ff = only
[init]
	defaultBranch = main
[rerere]
	enabled = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
